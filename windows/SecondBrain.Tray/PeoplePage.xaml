<UserControl x:Class="SecondBrain.Tray.PeoplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="People" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,12,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="PeopleList" SelectionChanged="PeopleList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="No saved people yet. Name a speaker on the Speakers page." Style="{StaticResource Caption}" FontSize="13" Margin="8" Visibility="Collapsed" />
            </Grid>
            <DockPanel x:Name="DetailPanel" Grid.Column="2" Visibility="Hidden">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="PersonTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PersonCaption" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Name" Style="{StaticResource SectionTitle}" />
                            <!-- The name box takes the remaining width so both buttons stay visible at the minimum window size. -->
                            <DockPanel>
                                <Button x:Name="ForgetButton" DockPanel.Dock="Right" Content="Forget person…" Margin="8,0,0,0" Click="Forget_Click" />
                                <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="Rename" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Click="Rename_Click" />
                                <TextBox x:Name="RenameBox" KeyDown="RenameBox_KeyDown" />
                            </DockPanel>
                            <TextBlock Text="Forget removes this person's voice references and clears all their assignments. Published notes are preserved." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Speaker rows" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Grid>
                    <ListBox x:Name="RowsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Open" Click="Open_Click" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoRowsText" Text="No speaker rows are assigned to this person." Style="{StaticResource Caption}" FontSize="13" Margin="8" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
