<UserControl x:Class="SecondBrain.Tray.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Right margin keeps cards clear of Fluent's overlay scrollbar. -->
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Ellipse x:Name="HealthDot" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,6,12,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReasonText" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <UniformGrid Columns="4" Margin="-6,0,-6,10">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Receiver" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ReceiverValue" Style="{StaticResource StatValue}" />
                        <TextBlock x:Name="ReceiverCaption" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Queue" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="PendingValue" Style="{StaticResource StatValue}" />
                        <TextBlock x:Name="QueueCaption" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Completed" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="CompleteValue" Style="{StaticResource StatValue}" />
                        <TextBlock Text="recordings" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="FailedValue" Style="{StaticResource StatValue}" />
                        <TextBlock Text="details on the Activity page" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Now" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ActivityText" FontSize="16" />
                        <TextBlock x:Name="InStageText" Style="{StaticResource Caption}" Margin="8,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,10,0,12" />
                    <ItemsControl x:Name="StageStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Chip" Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock x:Name="ChipText" Text="{Binding Label}" FontSize="12" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Review speakers" Style="{DynamicResource AccentButtonStyle}" Click="Review_Click" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Speakers" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="SpeakersText" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="NoEventsText" Text="No completed operations yet" Style="{StaticResource Caption}" />
                    <ItemsControl x:Name="RecentEvents">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
