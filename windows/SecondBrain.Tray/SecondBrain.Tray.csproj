<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationIcon>Assets\brain.ico</ApplicationIcon></PropertyGroup>
  <!-- Icons generated by scripts/make-tray-icons.ps1 from the Fluent UI Brain Circuit SVGs (MIT). -->
  <ItemGroup><Resource Include="Assets\*.ico" /></ItemGroup>
  <!-- WPF and WinForms share type names (Application, Button, ...): WinForms/Drawing types are referenced by alias.
       The WPF SDK drops System.IO from implicit usings because of System.Windows.Shapes.Path; add it back. -->
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /><Using Include="System.IO" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../SecondBrain.Status/SecondBrain.Status.csproj" /></ItemGroup>
</Project>
