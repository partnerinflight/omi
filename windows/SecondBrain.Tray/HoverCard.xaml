<Window x:Class="SecondBrain.Tray.HoverCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second Brain status" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        </StackPanel>
        <TextBlock x:Name="ReasonText" Style="{StaticResource Caption}" Margin="18,2,0,12" />
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="PendingText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="pending" Style="{StaticResource Caption}" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="ProcessingText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="processing" Style="{StaticResource Caption}" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="FailedText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="failed" Style="{StaticResource Caption}" />
            </StackPanel>
        </UniformGrid>
        <TextBlock x:Name="SpeakersText" TextWrapping="Wrap" />
        <TextBlock Text="Click the tray icon to open Second Brain" Style="{StaticResource Caption}" Margin="0,8,0,0" />
    </StackPanel>
</Window>
