#!/usr/bin/env bash
set -euo pipefail
# The suite needs Python 3.12+ (pyproject.toml). $PYTHON is often set globally for other tools
# (node-gyp) to the system 3.9, so use the first candidate that is new enough, $PYTHON first.
for p in "${PYTHON:-}" python3 python3.14 python3.13 python3.12; do
  if [ -n "$p" ] && command -v "$p" > /dev/null &&
      "$p" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2> /dev/null; then
    exec "$p" scripts/test.py
  fi
done
echo "pre-push: Python 3.12+ not found; set PYTHON=/path/to/python3.12 or newer" >&2
exit 1
